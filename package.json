{
  "name": "tmack48",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TMACK48 — official luxury artist universe. Cinematic promotional site for the TMACK48 YouTube brand.",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "build": "tsc -b --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "postbuild:cf": "node scripts/patch-cfasync.mjs",
    "deploy": "npm run build && npm run postbuild:cf && wrangler pages deploy dist --project-name=tmack48 --branch=main --commit-dirty=true",
    "deploy:all": "npm run build && npm run postbuild:cf && node scripts/deploy-retry.mjs",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "og": "node scripts/generate-og.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "esbuild": "^0.27.3",
    "framer-motion": "^12.40.0",
    "gsap": "^3.12.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.15.1",
    "three": "^0.184.0",
    "workerd": "^1.20260526.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "postcss": "^8.4.47",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "wrangler": "^4.95.0"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "workerd@1.20260526.1": true,
    "esbuild@0.27.3": true
  }
}
